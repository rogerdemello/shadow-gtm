# ── Google Gemini ─────────────────────────────────────────────────────────
# The one key a scan needs. Gemini does BOTH retrieval — reading competitor
# pages (URL-context tool) and searching the live web (Google Search grounding) —
# and the reasoning/extraction. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Defaults to gemini-2.5-flash-lite — the most generous FREE-TIER limits. On a
# paid key, use gemini-2.5-flash (sharper) or gemini-2.5-pro (deepest reasoning).
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional secondary model used as an extraction fallback if the primary fails
# (transient errors / quota). e.g. gemini-2.5-flash. Unset = no fallback.
GEMINI_MODEL_FALLBACK=
# Max concurrent Gemini calls process-wide. Default 1 — keeps you under the
# free-tier per-minute limit. Raise (e.g. 4) on a paid tier for faster scans.
GEMINI_MAX_CONCURRENCY=
# "1" feeds finished deep-dive dossiers back into the pipeline as signals (one
# extra Gemini call per dossier). Off by default to conserve free-tier quota.
DOSSIER_TO_SIGNALS=
# Optional thinking-budget cap in tokens. Unset = model decides dynamically.
# Set 0 to disable thinking for the snappiest live demo.
GEMINI_THINKING_BUDGET=

# ── Supabase (Postgres + Auth + Realtime) ──────────────────────────────────
# Create a project at https://supabase.com, then copy these from
# Project Settings → API. The URL + anon key are public (inlined into the client
# bundle); the service-role key is a server-only secret — never expose it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set to "1" once you've configured a SAML/OIDC SSO provider in Supabase Auth
# (Enterprise). Surfaces the "Sign in with SSO" button (domain → IdP routing).
NEXT_PUBLIC_SSO_ENABLED=
# Shared secret for the background scan worker (Phase 4). Set the same value in
# supabase/cron-setup.sql when wiring pg_cron after deploy. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WORKER_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Email alerts + the weekly digest. Get an API key at https://resend.com and
# verify a sending domain. When unset, the email layer no-ops (scans/digests
# still run; alerts stay in-app only). Enable the "email" channel in Settings.
RESEND_API_KEY=
# Verified sender, e.g. "Shadow GTM <alerts@yourdomain.com>".
EMAIL_FROM=
# Public base URL used for links in emails (your deployed app URL).
APP_URL=
# Deployment region id for data-residency reporting (e.g. "us", "eu"). Default "us".
APP_REGION=

# ── Billing (Stripe) ──────────────────────────────────────────────────────────
# When unset, billing is disabled and every workspace runs on the Free plan
# (quotas still enforced). Create products/prices in the Stripe dashboard.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…) from the Stripe webhook endpoint config.
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs for the self-serve tiers (price_…).
STRIPE_PRICE_STARTUP=
STRIPE_PRICE_GROWTH=

# ── App ───────────────────────────────────────────────────────────────────
# Optional: structured-log verbosity (debug|info|warn|error) and Sentry DSN.
# LOG_LEVEL=info
# SENTRY_DSN=
